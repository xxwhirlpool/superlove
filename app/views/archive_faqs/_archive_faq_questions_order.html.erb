<div id="manage-archive-faqs">
  <%= form_with url: url_for(:action => 'update_positions') do %>
    <ul id="sortable_archive_faq_list" class="sortable-list">
      <% @archive_faqs.each do |k, archive_faq| %>
        <li id="archive_faq_<%= archive_faq.id %>" class="archive_faq-position-list">
          <div class="position">
            <%= label_tag :archive_faq_position, "Position", class: 'landmark' %>
            <%= number_field_tag "position[]", k, :size => 3, :maxlength => 3, :id => "archive-faqs-position-#{archive_faq.id}" %>
            <%= hidden_field_tag "archive_faqs[]", archive_faq.id, :size => 3, :maxlength => 3, :id => "archive-faqs-#{archive_faq.id}" %>
          </div>
          <h3><%=h archive_faq.title %></h3>
        </li>
      <% end %>
    </ul>
    <div class="submit actions"><%= submit_tag "Update Positions" %></div>
  <% end %>
</div>