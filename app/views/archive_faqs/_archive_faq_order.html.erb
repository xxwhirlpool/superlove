<div id="manage-archive-faqs">
  <%= form_tag url_for(:action => 'update_positions') do %>
    <ol id="sortable-archive-faq-list" class="sortable-list">
      <% for archive_faq in @archive_faqs %>
        <li id="archive-faq-<%= archive_faq.id %>" data-index="<%= archive_faq.id %>" class="archive-faq-position-list" draggable="true">
          <div class="position">
            <%= label_tag :archive_faq_position, "Position", class: 'landmark' %>
            <%= number_field_tag "position[]", archive_faq.position, :size => 3, :maxlength => 3, :id => "archive_faqs_#{archive_faq.id}" %>
            <%= hidden_field_tag "archive_faqs[]", archive_faq.id, :size => 3, :maxlength => 3, :id => "archive_faqs_#{archive_faq.id}" %>
          </div>
          <h3><%=h archive_faq.title %></h3>
        </li>
      <% end %>
    </ol>
    <div class="submit"><%= submit_tag "Update Positions" %></div>
  <% end %>
</div>

<%= content_for :footer_js do %>
  <%= vite_tags "javascripts/faqdrag.js" %>
<% end %>
