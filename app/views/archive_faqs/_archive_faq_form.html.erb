<noscript>
  <% if Globalize.locale.to_s == "en" %>
    <%= form_tag({}, {:method => :get}) do %>
      <fieldset>
        <legend><%= t(".add_questions") %></legend>
        <p class="notes">
          <%= t(".no_javascript.explanation", num: @archive_faq.questions.count) %>
        </p>
        <div class="form-row side-label">
          <%= label_tag "num_questions", t(".no_javascript.questions_count_label") %>
          <div class="field">
            <%= number_field_tag "num_questions", params["num_questions"], class: "number" %>
          </div>
        </div>
        <div class="submit"><%= submit_tag t(".no_javascript.submit") %></div>
      </fieldset>
    <% end %>
  <% end %>
</noscript>

<%= form_for(@archive_faq, html: { class: "create faq" }) do |form| %>
  <%= error_messages_for @archive_faq %>
  <p class="required notice"><%= t(".required") %></p>
  <fieldset>
    <legend><%= t(".set_preferences") %></legend>
    <div class="form-row side-label required">
      <%= form.label :title, t(".category_name") + "*" %>
      <div class="field">
        <%= form.text_field :title, required: true %>
      </div>
    </div>
  </fieldset>

  <% # TODO: If you have the form set up to create 3 questions and you only fill in 2, you get an error instead of the totally empty section being ignored. This is the same with requests/offers in challenge signups. %>
  <h3><%= t(".questions_heading") %></h3>
  <div id="questions">
    <% form.object.questions.each_with_index do |question, index| %>
      <%= form.fields_for :questions, question do |question_form| %>
        <%= render "question_answer_fields", form: question_form, index: index %>
      <% end %>
    <% end %>
  </div>
  <% if Globalize.locale.to_s == "en" %>
    <div class="actions right">
      <%= link_to(t(".add_question"), '#', id: 'add-question', class: 'button') %>
    </div>
  <% end %>
  <fieldset>
    <div class="submit">
      <%= submit_tag t(".submit"), name: "post_button" %>
    </div>
  </fieldset>
<% end %>

<%= vite_tags 'javascripts/faqadd.js' %>