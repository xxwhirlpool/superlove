<% # load and cache site skin %>
<% if current_user.nil? || !current_user.nil? && !current_user.does_skin_override? %>
  <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
<% end %>

<%= skin_tag %>

<!--sandbox for developers	-->
<%= stylesheet_link_tag 'sandbox', skip_pipeline: true %>
<%= javascript_include_tag "highlightjs/highlight.min" %>
<%= javascript_include_tag "highlightjs/css.min" %>
<%= stylesheet_link_tag 'highlightjs/atelier-cave-light.min' %>
<%= javascript_include_tag "oneko.js", defer: true %>
<script type="text/javascript">hljs.highlightAll();</script>

<%= mute_css %>

<%= csrf_meta_tag %>
