<div id="known-issues" class="post create issue">
  <%= form_for(@known_issue) do |f| %>
    <%= error_messages_for @known_issue %>
    <fieldset>
      <div class="form-row side-label required">
        <%= f.label :title, ts("Beta Revision") + "*" %>
        <div class="field">
          <%= f.text_field :title, required: true %>
        </div>
      </div>
      <div class="form-row side-label required">
        <%= f.label :content, ts("Recent Known Issues") %>
        <div class="field">
          <ul class="rtf-html-switch actions" role="menu">
            <li><a class="rtf-link" href="#"><%= ts('Rich Text') %></a></li>
            <li><a class="html-link" href="#"><%= ts('HTML') %></a></li>
          </ul>
          <div class="rtf-html-instructions note">
            <span class="html-notes"><%= allowed_html_instructions %></span>
            <span class="rtf-notes"><%= ts("Type or paste formatted text.") %><%= link_to_help "rte-help" %></span>
          </div>
          <div class="rtf-html-field">
            <div id="rteditor"></div>
            <div id="plaintext"></div>
            <%= f.text_area :content, class: "observe_textlength", maxlength: ArchiveConfig.CONTENT_MAX, minlength: ArchiveConfig.CONTENT_MIN, required: true %>
            <%= generate_countdown_html("content", ArchiveConfig.CONTENT_MAX) %>
          </div>
        </div>
      </div>
      <div class="submit">
        <%= submit_tag ts("Post"), :name => 'post_button' %>
      </div>
    </fieldset>
  <% end %>
</div>

<% content_for :footer_js do %>
  <%= javascript_include_tag "rte", defer: true, type: 'module' %>
<% end %>