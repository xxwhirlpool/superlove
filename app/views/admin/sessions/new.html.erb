<!--Descriptive page name, messages and instructions-->
<h3><%= t(".page_heading") %></h3>
<!--/descriptions-->

<!--main content-->
<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "login post" } ) do |form| %>
<fieldset>
  <div class="form-row side-label">
    <%= form.label :login, t(".label.login") %>
    <div class="field">
      <%= form.text_field :login %>
    </div>
  </div>
  <div class="form-row side-label">
    <%= form.label :password, t(".label.password") %>
    <div class="field">
      <%= form.password_field :password %>
    </div>
  </div>
  <div class="submit">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
    <%= form.submit t(".submit"), class: "submit" %>
  </div>
</fieldset>
<% end %>
<div class="landmark"><%= t(".landmark.reset") %></div>
<p><%= link_to t(".reset_link"), new_admin_password_path %></p>
<!--/content-->
