<!--Descriptive page name, messages and instructions-->
<h2><%= t('.invite_user', :default => "Invite a User") %></h2>
<!--/descriptions-->

<!--subnav-->
<!--/subnav-->

<!--main content-->
<%= form_for :invitation, @invitation, :url => { :controller => 'admin/admin_invitations', :action => :create } do |f| %>
  <div class="form-row side-label">
    <%= f.label :recipient_email, t('.email_address', :default => "Email address") %>
    <div class="field">
      <%= f.text_field :recipient_email %>
    </div>
  </div>
  <div class="submit"><%= f.submit t('.submit', :default => "Invite!") %></div>
<% end %>
<!--/content-->

