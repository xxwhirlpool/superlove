<%= form_with model: @support_notice, url: @support_notice.new_record? ? admin_support_notices_path : admin_support_notice_path(@support_notice), html: { class: "post" } do |f| %>
  <%= error_messages_for @support_notice %>
  <p class="required notice"><%= "* #{t('.required_information')}" %></p>
  <fieldset>
    <legend><%= t(".legend.content") %></legend>
    <div class="form-row side-label required">
      <%= f.label :notice_content, "#{t('.text')}*" %>
      <div class="field">
        <div class="instructions"><%= allowed_html_instructions %></div>
        <%= f.text_area :notice_content, required: true %>
      </div>
    </div>
    <div class="form-row side-label required">
      <%= f.label :support_notice_type, "#{t('.type.label')}*" %>
      <div class="field">
        <ul class="radio-group">
          <li>
            <%= f.label :support_notice_type_notice do |l| %>
              <%= f.radio_button :support_notice_type, "notice", checked: true, required: true %>
              <%= t(".type.notice") %>
            <% end %>
          </li>
          <li>
            <%= f.label :support_notice_type_caution do |l| %>
              <%= f.radio_button :support_notice_type, "caution", required: true %>
              <%= t(".type.caution") %>
            <% end %>
          </li>
          <li>
            <%= f.label :support_notice_type_error do |l| %>
              <%= f.radio_button :support_notice_type, "error", required: true %>
              <%= t(".type.error") %>
            <% end %>
          </li>
        </ul>
      </div>
    </div>
    <div class="form-row side-label">
      <%= f.label :active, t(".active") %>
      <div class="field">
        <%= f.check_box :active %>
      </div>
    </div>
    <div class="submit actions">
      <%= f.submit @support_notice.new_record? ? t(".actions.create") : t(".actions.update") %>
    </div>
  </fieldset>
<% end %>
