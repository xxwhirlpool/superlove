<%= form_for @admin_banner, html: { class: 'post' } do |f| %>
  <%= error_messages_for @admin_banner %>
  
  <p class="required notice"><%= ts('* Required information') %></p>
  
  <fieldset>
    <legend><%= ts('Admin Banner') %></legend>
    <div class="form-row side-label required">
      <%= f.label :content, ts('Banner text') + '*' %>
      <div class="field">
        <%= f.text_area :content %>
        <%= allowed_html_instructions(strip_images: true) %>
      </div>
    </div>

    <div class="form-row side-label required">
      <%= f.label :banner_type_header, ts('Banner type') + '*' %>
      <div class="field">
        <ul class="radio-group">
          <li>
            <%= f.label :banner_type_ do |l|%>
              <%= f.radio_button :banner_type, '', checked: true, required: true %>
              <%= ts('Default') %>
            <% end %>
          </li>
          <li>
            <%= f.label :banner_type_event do |l| %>
              <%= f.radio_button :banner_type, 'event' %>
              <%= ts('Event (For membership drives, celebrations, etc.)') %>
            <% end %>
          </li>
          <li>
            <%= f.label :banner_type_alert do |l| %>
              <%= f.radio_button :banner_type, 'alert' %>
              <%= ts('Alert (For bugs, important changes, expected downtime, etc.)') %>
            <% end %>
          </li>
        </ul>
      </div>
    </div>

    <div class="form-row side-label">
      <%= f.label :active, ts('Active') %>
      <div class="field">
        <%= f.check_box :active %>
      </div>
    </div>

    <% if @admin_banner.active? %>
      <div class="form-row side-label">
        <%= label_tag :admin_banner_minor_edit, ts('This is a minor update (Do not turn the banner back on for users who have dismissed it)') %>
        <div class="field">
          <%= check_box_tag :admin_banner_minor_edit %>
        </div>
      </div>
    <% end %>
    
    <div class="submit">
      <%= f.submit @admin_banner.new_record? ? ts('Create Banner') : ts('Update Banner') %>
    </div>
  </fieldset>

<% end %>
