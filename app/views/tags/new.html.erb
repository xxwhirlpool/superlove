<!--Descriptive page name, messages and instructions-->
<h2><%= ts('New Tag') %></h2>

<%= error_messages_for :tag %>

<p><%= ts('Once you have created the tag, the attributes that are particular for that tag category will be available for editing.') %></p>

<!--/descriptions-->

<!--subnav-->
<!--/subnav-->

<!--main content-->
<%= form_for @tag, as: :tag, url: { action: "create" }  do |f| %>
  <fieldset>
    <div class="form-row side-label">
      <%= f.label :name, ts('Name') %>
      <div class="field">
        <%= f.text_field :name, size: ArchiveConfig.TAG_MAX %>
      </div>
    </div>

    <div class="form-row side-label">
      <%= f.label :canonical, ts('Canonical') %>
      <div class="field">
        <%= f.check_box :canonical %>
      </div>
    </div>

    <div class="form-row side-label">
      <%= label_tag :type, ts('Category') %>
      <div class="field">
        <% if logged_in_as_admin? %>
          <% types = Tag::TYPES  %>
        <% else %>
          <% types = Tag::USER_DEFINED %>
        <% end %>
        <ul class="radio-group">
          <% types.each do |type| %>
            <li>
              <%= f.radio_button("type", type) %>
              <%= f.label("type_#{type.downcase}", ts("%{type}", type: tag_type_label_name(type))) %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
    
    <div class="submit">
      <%= f.submit %>
    </div>
  </fieldset>
<% end %>
<!--/content-->

<!--subnav-->
<!--/subnav-->
