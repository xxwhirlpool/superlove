<h2 class="landmark"><%= t(".page_title") %></h2>

<div class="caution">
  <%= t(".caution") %>
</div>

<ul class="actions">
  <li>
    <%= link_to t(".navigation.continue"), current_path_with(view_adult: true) %>
  </li>
  <li>
    <%= link_to t(".navigation.back"), :back %>
  </li>
  <% if logged_in? %>
    <li>
      <%= link_to t(".navigation.preferences"), user_preferences_path(current_user) %>
    </li>
  <% end %> 
</ul>

<div class="message">
  <%= t(".footnote") %>
</div>

<div id="work_<%= @work.id %>" class="work <% if is_author_of?(@work) %> own<% end %><% if @work.unrevealed? %> mystery<% end %><%= css_classes_for_creation_blurb(@work) %>">
  <%= render "works/work_module", work: @work %>
  <%= render "works/work_author_actions", work: @work %>
</div>