<!--REVIEW: trying out articles on these fieldsets to see if that's a better chunker, but may revert after testing. Have also tossed in landmarks on top level groups-->
<%= form_for(@work, html: { id: "work-form", 'x-data': 'work' }) do |f| %>
  <div class="required notice">* <%= ts("Required information") %></div>

  <%= render "work_form_tags", include_blank: false %>

  <fieldset class="preface">
    <legend><%= t("works.preface.title") %></legend>
    <div class="form-row side-label required">
      <%= f.label :title, ts("Work Title") + "*" %>
      <div class="field-wrapper">
        <%= f.text_field :title, class: "observe_textlength text", maxlength: ArchiveConfig.TITLE_MAX, minlength: ArchiveConfig.TITLE_MIN %>
        <%= generate_countdown_html("work_title", ArchiveConfig.TITLE_MAX) %>
      </div>
    </div>

    <!-- Add coauthors-->
    <%= render "pseuds/byline", form: f, object: @work %>

    <div class="form-row side-label">
      <%= f.label :summary, ts("Summary", max: ArchiveConfig.SUMMARY_MAX.to_s) %>
      <div class="field-wrapper">
        <%= f.text_area :summary, class: "observe_textlength", maxlength: ArchiveConfig.SUMMARY_MAX %>
        <%= generate_countdown_html("work_summary", ArchiveConfig.SUMMARY_MAX) %>
      </div>
    </div>
    <!-- notes -->
    <%= render "notes_form", f: f, type: "work" %>
  </fieldset>

  <fieldset id="associations">
    <legend><%= t("works.associations.title") %></legend>
      <% @assignments = get_open_assignments(current_user) %>
      <% if @assignments.any? || @work.challenge_assignments.any? %>
        <!-- if the user has open assignments? -->
        <div class="form-row side-label">
          <%= f.label "challenge_assignment_ids[]" do %>
            <%= ts("Does this fulfill a challenge assignment") %>
            <%= link_to_help "add-work-to-assignment" %>
          <% end %>
          <div class="field">
            <h4><%= ts("Open Assignments") %></h4>
            <%= checkbox_section f, :challenge_assignment_ids, (@work.challenge_assignments + @assignments).uniq,
                  :checked_method => "challenge_assignments", :name_method => "title", :class => 'radio-group' %>
          </div>
        </div>
      <% end %>

      <% if !(@claims = current_user.request_claims.unstarted).empty? || !@work.challenge_claims.empty? %>
        <!-- if the user has open claims? -->
        <div class="form-row side-label">
          <%= f.label "challenge_claim_ids[]" do %>
            <%= ts("Fulfill a Claim") %>
            <%= link_to_help "add-work-to-assignment" %>
          <% end %>
          <div class="field">
            <h4><%= ts("Open Claims") %></h4>
            <%= checkbox_section f, :challenge_claim_ids, (@work.challenge_claims + @claims).uniq,
                :checked_method => "challenge_claims", :name_helper_method => "claim_title" %>
          </div>
        </div>
      <% end %>

      <!-- Add collection -->
      <div class="form-row side-label">
        <%= f.label :collection_names do %>
          <%= ts("Post to Collections / Challenges") %>
          <%= link_to_help "add-collectible-to-collection" %>
        <% end %>
        <div class="field">
          <%= f.text_field :collection_names, autocomplete_options("open_collection_names") %>
        </div>
      </div>

      <div class="form-row side-label">
        <%= f.label :recipients do %>
          <%= ts("Gift this work to") %>
          <%= link_to_help "recipients" %>
        <% end %>
        <div class="field">
          <%= f.text_field :recipients, autocomplete_options("pseud", value: @work.recipients(for_form = true)) %>
        </div>
      </div>

      <!-- Inspiration / remix -->
      <div class="form-row side-label">
        <%= label_tag "parent-options-show" do %>
          <%= ts("This work is a remix, a translation, a podfic, or was inspired by another work") %>
          <%= link_to_help "parent-works-help" %>
        <% end %>
        <div class="field">
          <%= check_box_tag "parent-options-show", "1", check_parent_box(@work), class: "toggle_formfield", "data-toggle": "parent-options" %>
          <!-- Toggles on with parent checkbox -->
          <fieldset id="parent-options" class="hidden">
            <% new_parent, existing_parents = @work.parent_work_relationships.partition(&:new_record?) %>
            <% new_parent << @work.parent_work_relationships.build if new_parent.empty? %>
  
            <%= f.fields_for :parent_work_relationships, new_parent do |p| %>
              <div class="form-row">
                <%= p.label :url, ts("URL") %>
                <%= p.text_field :url,
                      "aria-describedby" => "parent-attributes-url-field-description" %>
                <div class="help" id="parent-attributes-url-field-description">
                  <%= ts("For a work in the Archive, only the URL is required.") %>
                </div>
              </div>

              <div class="form-row">
                <%= p.label :title %>
                <%= p.text_field :title %>
              </div>

              <div class="form-row">
                <%= p.label :author %>
                <%= p.text_field :author %>
              </div>

              <div class="form-row">
                <%= p.label :language_id do %>
                  <%= ts("Language") %>
                  <%= link_to_help "languages-help" %>
                <% end %>
                <%= p.select(:language_id, language_options_for_select(sorted_languages, "id"), prompt: " ") %>
              </div>

              <div class="form-row">
                <%= p.label :translation do %>
                  <%= p.check_box :translation %>
                  <%= ts("This is a translation") %>
                  <%= link_to_help "translation-link" %>
                <% end %>
              </div>
            <% end %>

            <% unless existing_parents.blank? %>
              <div class="form-row">
                <%= label_tag :related_works, ts("Current parent works") %>
                <% existing_parents.each do |related_work| %>
                  <% if related_work.parent %>
                    <div class="field">
                      <ul class="actions">
                        <li>
                          <%= link_to related_work.parent.title, related_work.parent %>
                        </li>
                        <li>
                          <%= link_to ts("Remove"), related_work,
                                  data: { confirm: ts("Are you sure you want to delete the connection to this work?") },
                                  method: :delete %>
                        </li>
                      </ul>
                    </div>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </fieldset>
        </div>
      </div>

      <!-- Series checkbox (storyseriescheck) -->
      <!-- Checking this box causes the "manage series" dropdown to appear; unchecking it causes it to disappear. -->
      <div class="form-row side-label">
        <%= label_tag "series-options-show" do %>
          <%= ts("This work is part of a series") %>
          <%= link_to_help "choosing-series" %>
        <% end %>
        <div class="field">
          <%= check_box_tag "series-options-show", "1", check_series_box(@work), class: "toggle_formfield", "data-toggle": "series-options" %>
          <!-- Toggles on with series checkbox -->
          <fieldset id="series-options" class="hidden">
            <%= fields_for "work[series_attributes]" do |s| %>
              <div class="form-row side-label">
                <%= s.label "id", ts("Choose one of your existing series:") %>
                <%= s.collection_select(:id, @series, :id, :title, { selected: work_series_value(:id), prompt: true }) %>
              </div>

              <div class="form-row side-label">
                <%= s.label :title, ts("Or create and use a new one:") %>
                <%= s.text_field :title, value: work_series_value(:title) %>
              </div>
            <% end %>
  
            <% unless @serial_works.blank? || @work.new_record? %>
              <div class="form-row">
                <%= label_tag ts("Current Series") %>
                <% for serial in @serial_works %>
                  <% unless serial.new_record? %>
                    <div class="field">
                      <ul class="actions">
                        <li>
                          <%= link_to serial.series.title, serial.series %>
                        </li>
                        <li>
                          <%= link_to ts("Remove Work From Series"), serial_work_path(serial),
                                  method: :delete %>
                        </li>
                      </ul>
                    </div>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </fieldset>
        </div>
      </div>

      <%= fields_for "work[chapter_attributes]", @chapter do |c| %>
        <!-- Chaptered checkbox (work_is_wip) -->
        <!-- Checking this box causes the expected number of chapters box to appear; unchecking it causes it to disappear. -->
        <div class="form-row side-label">
          <%= label_tag "chapters-options-show" do %>
            <%= ts("This work has multiple chapters") %>
          <% end %>
          <div class="field">
            <%= check_box_tag "chapters-options-show", "1", @work.chaptered?, class: "toggle_formfield", "data-toggle": "chapters-options" %>
            <fieldset id="chapters-options" class="hidden">
              <div class="form-row side-label">
                <%= f.label :wip_length, ts("Chapter 1 of") %>
                <div class="field">
                  <%= f.number_field :wip_length %>
                </div>
              </div>
              <div class="form-row side-label">
                <%= c.label :title, ts("Chapter Title:") %>
                <div class="field">
                  <%= c.text_field :title, value: @chapter.title %>
                </div>
              </div>
            </fieldset>
          </div>
        </div>

        <!--backdate-->
        <div class="form-row side-label">
          <%= label_tag "backdate-options-show" do %>
            <%= ts("Set a different publication date") %>
            <%= link_to_help "backdating-help" %>
          <% end %>
          <div class="field">
            <%= f.check_box :backdate, { id: "backdate-options-show", class: "toggle_formfield", "data-toggle": "backdate-options" } %>
            <fieldset id="backdate-options" class="optional hidden">
              <div class="form-row side-label">
                <%= label_tag "published_at", ts("Set publication date") %>
                <div class="field">
                  <%= c.date_select("published_at", :start_year => Date.current.year, :end_year => 1950, :default => Date.current, :value => @chapter.published_at, :order => [:day, :month, :year]) %>
                </div>
              </div>
            </fieldset>
          </div>
        </div>

        <%= render "work_form_associations_language", f: f %>

        <div class="form-row side-label">
          <%= f.label :work_skin_id do %>
            <%= t("works.skin.select") %>
            <%= link_to_help "work-skins" %>
          <% end %>
          <div class="field">
            <%= f.collection_select :work_skin_id, all_coauthor_skins, :id, :title,
                  { :selected => (@work.work_skin ? @work.work_skin.id.to_s : nil), include_blank: true } %>
            <div class="actions" role="navigation">
              <%= link_to ts("Public Work Skins"), skins_path(:skin_type => "WorkSkin") %>
            </div>
          </div>
        </div>

      </fieldset>

  <!-- privacy settings -->
  <fieldset class="privacy">
    <legend><%= t("works.permissions.privacy") %></legend>
    <!-- Privacy dropdown (storyprivacy) -->
    <div class="form-row side-label">
      <%= f.label :restricted do %>
        <%= t("works.permissions.visibility.restricted") %>
        <%= link_to_help "registered-users" %>
      <% end %>
      <div class="field">
        <%= f.check_box :restricted %>
      </div>
    </div>

    <div class="form-row side-label">
      <%= f.label :moderated_commenting_enabled do %>
        <%= t("comments.commentable.permissions.moderated_commenting.enable") %>
        <%= link_to_help "comments-moderated" %>
      <% end %>
      <div class="field">
        <%= f.check_box :moderated_commenting_enabled %>
      </div>
    </div>

    <div class="form-row side-label">
      <%= label_tag :comments_commentable_permissions_options do %>
        <%= t("comments.commentable.permissions.options.label") %>
        <%= link_to_help "who-can-comment-on-this-work" %>
      <% end %>
      <div class="field">
        <%=
          radio_button_list(f, :comment_permissions, [
            [:enable_all, t("comments.commentable.permissions.options.enable_all")],
            [:disable_anon, t("comments.commentable.permissions.options.disable_anon")],
            [:disable_all, t("comments.commentable.permissions.options.disable_all")]
          ])
        %>
      </div>
    </div>
  </fieldset>
  <% unless @chapters %>
    <!-- Work text field (chapter_attributes_content) -->
    <fieldset id="work" class="work">
      <ul class="rtf-html-switch hidden actions right">
        <li><button class="rtf-link" data-rteditor="rteditor" data-pteditor="plaintext"><%= ts("Rich Text") %></button></li>
        <li><button class="html-link" data-rteditor="rteditor" data-pteditor="plaintext"><%= ts("HTML") %></button></li>
      </ul>
      <p class="rtf-html-instructions note">
        <span class="html-notes"><%= allowed_html_instructions %></span>
        <span class="hidden rtf-notes">
          <%= ts("Type or paste formatted text.") %><%= link_to_help "rte-help" %>
        </span>
      </p>
      <p class="notice">
        <%= ts("<strong>Note:</strong> Text entered in the posting form is <strong>not</strong> automatically saved. Always keep a backup copy of your work.").html_safe %>
      </p>
      
      <div class="rtf-html-field">
        <%= label_tag :content, "#{ts("Work Text")} *" %>
        <div id="rteditor"></div>
        <%= c.text_area :content, value: @chapter.content,
              class: "observe_textlength large", id: "plaintext", maxlength: ArchiveConfig.CONTENT_MAX_DISPLAYED, "data-plural": " characters remaining", "data-singular": " character remaining", minlength: ArchiveConfig.CONTENT_MIN %>

        <%= generate_countdown_html("plaintext", ArchiveConfig.CONTENT_MAX_DISPLAYED) %>
      </div>
    <% end %>

  <% end %><!-- end of fields for chapters -->

  <%= render "posting_fieldset" %>

<% end %> <!-- end of form_for -->

<%= content_for :footer_js do %>
  <%= vite_tag "javascripts/rte.js" %>
  <%= vite_tag "javascripts/counter.js" %>
  <%= vite_tags 'javascripts/workform.js' %>
  <%= javascript_tag do %>
    document.addEventListener('ready', (_e) => {
      document.querySelectorAll('.toggle_formfield').addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = e.target.getAttribute('id').replace('-show', '');
        targetId.classList.toggle('hidden');
      });
    });
  <% end %>
<% end %>
