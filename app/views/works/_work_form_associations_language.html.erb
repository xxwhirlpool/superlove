<div class="form-row side-label">
  <%= f.label :language_id do %>
    <%= "#{t('works.associations.language.choose')} *" %>
    <%= link_to_help "languages-help" %>
  <% end %>
  <div class="field">
    <select id="work_language_id" name="work[language_id]" required>
      <option value=""><%= ts("Please select a language") %></option>
      <%= options_for_select(language_options_for_select(sorted_languages, "id"), @work.language_id) %>
    </select>
  </div>
</div>
