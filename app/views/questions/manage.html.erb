<h2><%= @archive_faq.title %></h2>
<div id="manage-questions">
  <h3><%= ts("Reorder questions") %></h3>

  <p><%= ts("Drag questions to change their order.") %></p>
  <noscript><p><%= ts("Enter new question numbers.") %></p></noscript>
  <%= form_tag url_for(action: 'update_positions') do %>
    <ol id="sortable-question-list" class="sortable-list">
      <% i = 1 %>
      <% for question in @questions %>
        <li id="question_<%= question.id %>" data-index="<%= question.id %>" class="question-position-list" draggable="true">
          <div class="position">
            <%= label_tag :archive_faq_position, "Position", class: 'landmark' %>
            <%= number_field_tag 'positions[]', i, size: 3, maxlength: 3, class: 'question-position-field', id: 'questions_' + question.position.to_s %>
            <%= hidden_field_tag "questions[]", question.id, :size => 3, :maxlength => 3, :id => "question-faqs_#{question.id}" %>
          </div>
          <%= question.question.html_safe %>
        </li>
        <% i = i + 1 %>
      <% end %>
    </ol>
    <p class="submit actions">
      <%= submit_tag ts("Update Positions") %>
      <%= link_to ts("Back"), url_for(@archive_faq) %>
    </p>
  <% end %>
</div>

<%= content_for :footer_js do %>
  <%= vite_tags "javascripts/faqdrag.js" %>
<% end %>